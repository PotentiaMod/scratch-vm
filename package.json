    "scratch-parser": "github:TurboWarp/scratch-parser#master",
    "scratch-sb1-converter": "0.2.7",
    "scratch-translate-extension-languages": "^1.0.7",
	"sentiment": "^5.0.2",
    "simplex-noise": "^4.0.1",
    "socket.io-client": "2.2.0",
    "speech-synth": "^1.0.1",
    "sweetalert2": "^11.10.8",
	"taffydb": "^2.7.3",
    "text-encoding": "0.7.0",
