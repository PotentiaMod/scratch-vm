	"@turbowarp/scratch-svg-renderer": "^1.1.0",
    "adm-zip": "0.4.11",
    "babel-eslint": "10.1.0",
    "babel-loader": "8.2.2",
    "callsite": "1.0.0",
    "copy-webpack-plugin": "4.5.4",
    "docdash": "1.2.0",
